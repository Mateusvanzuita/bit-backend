// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id              String   @id @default(uuid())
  email           String   @unique
  nome            String
  senha           String
  avatar          String?

  dataNascimento  DateTime?
  sexo            Sexo?

  notificacoesAtivas Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pets            Pet[]
  notificacoes Notificacao[]
  salvos Salvo[]
  aceiteTermos UserAceiteTermos[]
  sosAtendimentos SosAtendimento[]
  petShopsSeguidores  PetShopSeguidor[]
  petShopFavorito     PetShopFavorito?
  cupomResgates       CupomResgate[]
  pushToken           String?

  latitude   Float?
  longitude  Float?
  cidade     String?
  estado     String?
  pais       String?   @default("BR")

  @@map("users")
}


model Notificacao {
  id          String   @id @default(uuid())

  titulo      String
  mensagem    String

  tipo        TipoNotificacao
  pathKey     String?

  lida        Boolean  @default(false)

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  lidaEm      DateTime?

  @@index([userId, lida])
  @@map("notificacoes")
}


model Salvo {
  id          String   @id @default(uuid())

  titulo      String
  descricao   String?

  tipo        TipoSalvo
  referenciaId String
  pathKey     String

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tipo, referenciaId])
  @@map("salvos")
}


model Pet {
  id        String   @id @default(uuid())
  nome      String
  foto      String?
  raca      String?
  
  dataNascimento DateTime?
  idade           Int?
  meses           Int?

  peso     Float?
  especie  Especie
  cor      String?
  sexo     SexoPet
  porte    Porte

  microchip  String?
  castrado   Boolean @default(false)

  veterinarioResponsavel String?

  alergiasRestricoes String[]
  doencasCronicas    String[]

  comportamento Comportamento

  convivencia Convivencia[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
// Relacionamentos para Dicas
  historicosDicas       PetDicaHistorico[] // Oposto de PetDicaHistorico.pet
  respostasDicas        PetDicaResposta[]
  analises AnaliseHistorico[]
  sosAtendimentos SosAtendimento[]
  vacinas Vacina[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pets")
}

model Vacina {
  id           String   @id @default(uuid())
  nome         String
  categoria    String   // "vaccine" ou "dewormer"
  recorrente   Boolean  @default(true)
  
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  doses        DoseVacina[]
  observacoes   String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vacinas")
}

model DoseVacina {
  id           String   @id @default(uuid())
  dataAplicada DateTime
  proximaDose  DateTime?
  tipo         String   // Ex: "Reforço anual", "1ª Dose"
  observacoes   String?   @db.Text
  vacinaId     String
  vacina       Vacina   @relation(fields: [vacinaId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("doses_vacinas")
}


model Dica {
  id          String @id @default(uuid())
  titulo      String
  descricao   String
  icone       String?
  prompt    String?  @db.Text

  createdAt  DateTime @default(now())
historicos  PetDicaHistorico[] // Oposto de PetDicaHistorico.dica
  etapas     DicaEtapa[]
  respostas  PetDicaResposta[]

  @@map("dicas")
}


model DicaEtapa {
  id       String @id @default(uuid())
  titulo   String
  ordem    Int

  dicaId  String
  dica    Dica @relation(fields: [dicaId], references: [id], onDelete: Cascade)

  opcoes  DicaOpcao[]
  respostas PetDicaResposta[]

  @@map("dica_etapas")
}


model DicaOpcao {
  id        String @id @default(uuid())
  texto     String
  valor     String
  ordem     Int

  etapaId  String
  etapa    DicaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  respostas PetDicaResposta[]

  @@map("dica_opcoes")
}


model PetDicaHistorico {
  id          String   @id @default(uuid())
  
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  dicaId      String
  dica        Dica     @relation(fields: [dicaId], references: [id], onDelete: Cascade)

  resultadoIA String?  @db.Text
  concluida   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  respostas   PetDicaResposta[]

  @@map("pet_dica_historicos")
}

// Ajustar o PetDicaResposta para apontar para o Historico em vez de diretamente para o Pet/Dica (opcional, mas recomendado para manter histórico)
model PetDicaResposta {
  id          String   @id @default(uuid())
  
  historicoId String
  historico   PetDicaHistorico @relation(fields: [historicoId], references: [id], onDelete: Cascade)

  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  dicaId      String
  dica        Dica     @relation(fields: [dicaId], references: [id])

  etapaId     String
  etapa       DicaEtapa @relation(fields: [etapaId], references: [id])

  // Alterado para opcional (?) para permitir perguntas de texto puro
  opcaoId     String?
  opcao       DicaOpcao? @relation(fields: [opcaoId], references: [id])

  // CAMPO FALTANTE ADICIONADO ABAIXO:
  valor       String?   @db.Text

  createdAt   DateTime @default(now())

  @@map("pet_dica_respostas")
}


model Analise {
  id          String @id @default(uuid())
  titulo      String
  descricao   String
  icone       String?
  prompt      String?  @db.Text

  createdAt DateTime @default(now())

  etapas     AnaliseEtapa[]

  historicos AnaliseHistorico[]

  @@map("analises")
}


model AnaliseEtapa {
  id       String @id @default(uuid())
  titulo   String
  ordem    Int

  permiteTexto Boolean @default(false)
  permiteFoto  Boolean @default(false)

  analiseId String
  analise   Analise @relation(fields: [analiseId], references: [id], onDelete: Cascade)

  opcoes    AnaliseOpcao[]

  respostas AnaliseResposta[]

  @@map("analise_etapas")
}


model AnaliseOpcao {
  id       String @id @default(uuid())
  texto    String
  valor    String
  ordem    Int

  etapaId String
  etapa   AnaliseEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  respostas AnaliseResposta[]

  @@map("analise_opcoes")
}


model AnaliseHistorico {
  id        String @id @default(uuid())

  petId    String
  pet      Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  analiseId String
  analise   Analise @relation(fields: [analiseId], references: [id])
  resultadoIA String?  @db.Text
  concluida Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respostas AnaliseResposta[]

  @@map("analise_historicos")
}


model AnaliseResposta {
  id String @id @default(uuid())

  historicoId String?
  historico   AnaliseHistorico? @relation(fields: [historicoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   AnaliseEtapa @relation(fields: [etapaId], references: [id])

  opcaoId String?
  opcao   AnaliseOpcao? @relation(fields: [opcaoId], references: [id])

  texto   String?
  fotoUrl String?

  createdAt DateTime @default(now())

  @@unique([historicoId, etapaId])
  @@map("analise_respostas")
}


enum TipoNotificacao {
  DICA
  ANALISE
  LEMBRETE
  SAUDE
  SISTEMA
}


model BannerHome {
  id          String   @id @default(uuid())

  titulo      String?
  descricao   String?

  imagemUrl   String
  pathKey     String?

  ativo       Boolean  @default(true)
  ordem       Int      @default(0)

  dataInicio  DateTime?
  dataFim     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ativo])
  @@map("banners_home")
}

model SosAtendimento {
  id           String   @id @default(uuid())
  mensagemUser String   @db.Text
  respostaIA   String   @db.Text
  
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historico String? @db.Text 

  status    String  @default("ativo") 
  createdAt    DateTime @default(now())

  @@map("sos_atendimentos")
}

model PoliticaPrivacidade {
  id             String   @id @default(uuid())
  versao         String?  @unique // Opcional
  conteudo       String?  @db.Text // Opcional
  publicadoEm    DateTime @default(now())
  
  aceites        UserAceiteTermos[]

  @@map("politicas_privacidade")
}

model TermoUso {
  id             String   @id @default(uuid())
  versao         String?  @unique // Opcional
  conteudo       String?  @db.Text // Opcional
  publicadoEm    DateTime @default(now())

  aceites        UserAceiteTermos[]

  @@map("termos_uso")
}

model UserAceiteTermos {
  id                    String   @id @default(uuid())
  
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  politicaPrivacidadeId String?
  politicaPrivacidade   PoliticaPrivacidade? @relation(fields: [politicaPrivacidadeId], references: [id])

  termoUsoId            String?
  termoUso              TermoUso?            @relation(fields: [termoUsoId], references: [id])

  aceitoEm              DateTime @default(now())
  ip                    String?

  @@map("user_aceite_termos")
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime 
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_codes")
}

// ============================================================
//  BITZY CLUB — Adições ao schema.prisma existente
//  Cole estes models após os models existentes no seu schema.
//  Adicione também os novos enums ao bloco de enums existente.
// ============================================================


// ─────────────────────────────────────────────────────────────
//  PETSHOP PARCEIRO
//  Estabelecimentos cadastrados no Bitzy Club (R$99/mês)
// ─────────────────────────────────────────────────────────────
model PetShop {
  id            String   @id @default(uuid())

  nome          String
  descricao     String?  @db.Text
  logoUrl       String?
  bannerUrl     String?

  // Endereço / localização
  endereco      String
  cidade        String
  estado        String
  pais          String   @default("BR")
  latitude      Float
  longitude     Float

  // Contato
  telefone      String?
  whatsapp      String?
  instagram     String?
  website       String?

  // Plano Bitzy Club
  ativo         Boolean  @default(true)
  planoAtivo    Boolean  @default(false)
  planoInicioEm DateTime?
  planoFimEm    DateTime?

  // Desconto fixo para quem FAVORITA (pet shop escolhe o %, mínimo 5%)
  descontoFavorito Float @default(10.0)

  // Limite de cupons ativos por mês (padrão MVP = 10)
  limiteCuponsAtivos Int @default(10)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cupons        Cupom[]
  seguidores    PetShopSeguidor[]
  favoritos     PetShopFavorito[]

  @@index([cidade, estado])
  @@index([latitude, longitude])
  @@index([ativo, planoAtivo])
  @@map("pet_shops")
}


// ─────────────────────────────────────────────────────────────
//  SEGUIDOR DE PET SHOP
//  Usuário "segue" N pet shops para receber promoções
// ─────────────────────────────────────────────────────────────
model PetShopSeguidor {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petShopId  String
  petShop    PetShop  @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, petShopId])
  @@index([userId])
  @@map("pet_shop_seguidores")
}


// ─────────────────────────────────────────────────────────────
//  FAVORITO DE PET SHOP  (limite: 1 por usuário)
//  Quem favorita recebe o descontoFavorito permanente
// ─────────────────────────────────────────────────────────────
model PetShopFavorito {
  id         String   @id @default(uuid())

  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petShopId  String
  petShop    PetShop  @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  descontoSnapshot Float

  favoritadoEm DateTime @default(now())

  @@index([petShopId])
  @@map("pet_shop_favoritos")
}


// ─────────────────────────────────────────────────────────────
//  CUPOM
//  Criado pelo pet shop; pode ser fixo, sazonal ou favorito
// ─────────────────────────────────────────────────────────────
model Cupom {
  id            String   @id @default(uuid())

  petShopId     String
  petShop       PetShop  @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  // ── Identidade ────────────────────────────────────────────
  // Nome da promoção (ex: "Banho Premiado", "Semana da Ração")
  titulo        String
  descricao     String?  @db.Text
  codigoDisplay String?              // ex: "BITZY10" — mostrado na tela
  bannerUrl     String?              // foto/arte do cupom (opcional)

  // ── Categorização ─────────────────────────────────────────
  // Categoria principal (usada para ícone e filtro no app)
  categoria     CategoriaCupom   @default(OUTROS)

  // Subcategoria livre (ex: "Banho + Tosa", "Ração Premium", "Bravecto")
  // Preenchida pelo admin no cadastro; exibida como detalhe no card
  subcategoria  String?

  // ── Tipo do benefício ─────────────────────────────────────
  tipoBeneficio TipoBeneficio    @default(DESCONTO_PERCENTUAL)

  // Valor numérico — usado quando tipoBeneficio é DESCONTO_PERCENTUAL ou DESCONTO_FIXO
  // Para BRINDE e COMBO, deixar null e descrever no campo `descricao`
  valorDesconto Float?

  // ── Tipo interno (para lógica de negócio) ─────────────────
  // FIXO = permanente/recorrente | SAZONAL = campanha com datas | FAVORITO = gerado ao favoritar
  tipo          TipoCupom        @default(FIXO)

  // ── Objetivo estratégico (para métricas e relatórios) ─────
  objetivo      ObjetivoCupom    @default(FIDELIZACAO)

  // ── Ícone visual no card ──────────────────────────────────
  iconeTipo     TipoCupomIcone   @default(DESCONTO)

  // ── Duração ───────────────────────────────────────────────
  duracaoTipo   DuracaoCupom     @default(PERMANENTE)

  dataInicio    DateTime         @default(now())
  dataFim       DateTime?        // null = sem expiração (PERMANENTE)

  // Happy Hour: horário específico (ex: "14:00" e "17:00")
  // Armazenado como string HH:MM para simplicidade
  happyHourInicio String?        // ex: "14:00"
  happyHourFim    String?        // ex: "17:00"

  // ── Limites de uso ────────────────────────────────────────
  limiteUsoTotal   Int?          // null = sem limite global
  limiteUsoPorUser Int  @default(1)

  // ── Estado e métricas ─────────────────────────────────────
  ativo          Boolean  @default(true)
  destaque       Boolean  @default(false)   // "botão destacar cupom"
  totalResgates  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resgates       CupomResgate[]

  @@index([petShopId, ativo])
  @@index([tipo])
  @@index([categoria])
  @@index([dataFim])
  @@index([destaque, ativo])
  @@map("cupons")
}


// ─────────────────────────────────────────────────────────────
//  CUPOM RESGATE
//  Registro de cada vez que um usuário resgata/usa um cupom
//  "alienado ao petshop e ao usuário"
// ─────────────────────────────────────────────────────────────
model CupomResgate {
  id         String        @id @default(uuid())

  cupomId    String
  cupom      Cupom         @relation(fields: [cupomId], references: [id], onDelete: Cascade)

  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     StatusResgate @default(ATIVO)

  // Snapshots no momento do resgate (protege histórico)
  petShopId           String
  petShopNome         String
  cupomTitulo         String
  cupomCategoria      CategoriaCupom?
  descontoSnapshot    Float?
  tipoBeneficioSnapshot TipoBeneficio?
  dataFimSnapshot     DateTime?

  avisoEnviado  String?  @map("aviso_enviado") // null | '48h' | '24h' | '4h'

  resgatadoEm   DateTime @default(now())
  utilizadoEm   DateTime?
  expiradoEm    DateTime?

  @@unique([cupomId, userId])
  @@index([userId, status])
  @@index([petShopId])
  @@index([status, dataFimSnapshot])
  @@map("cupom_resgates")
}

// ── Categoria principal do cupom ──────────────────────────────
// Usada para ícone no card e filtro no explorar
enum CategoriaCupom {
  SERVICOS        // Banho, Tosa, Consulta, Hotelzinho...
  ALIMENTACAO     // Ração, Sachê, Petiscos, Ossinhos...
  SAUDE           // Vermífugo, Antipulgas, Vitaminas...
  ACESSORIOS      // Coleiras, Caminhas, Brinquedos...
  GATO            // Areia, Ração felina, Arranhador...
  OUTROS
}

// ── Tipo do benefício (o QUE o cliente ganha) ─────────────────
enum TipoBeneficio {
  DESCONTO_PERCENTUAL   // 10% OFF, 15% OFF...
  DESCONTO_FIXO         // R$10 OFF, R$20 OFF...
  BRINDE                // Banho ganha hidratação, ração ganha petisco...
  COMBO                 // Banho + Tosa com desconto, 2 banhos por preço especial...
}

// ── Duração do cupom (EXPANDIDA) ──────────────────────────────
enum DuracaoCupom {
  PERMANENTE    // Sempre ativo — ex: "10% em banho às terças"
  MENSAL        // Dura o mês inteiro — ex: "Promoção de julho"
  SEMANAL       // Dura a semana — ex: "Semana do Gato"
  FLASH         // Poucas horas (usa dataFim) — ex: "Somente hoje"
  HAPPY_HOUR    // Horário específico (usa happyHourInicio/Fim) — ex: "Das 14h às 17h"
  SAZONAL       // Datas especiais com início/fim — ex: "Black Friday", "Natal"
}

// ── Tipo interno (lógica de negócio) ─────────────────────────
enum TipoCupom {
  FIXO       // Cupons recorrentes/permanentes do pet shop
  SAZONAL    // Campanhas com datas (Black Friday, Natal...)
  FAVORITO   // Gerado automaticamente ao favoritar o pet shop
}

// ── Objetivo estratégico (para relatórios) ───────────────────
enum ObjetivoCupom {
  FIDELIZACAO          // Manter cliente voltando
  RECUPERACAO          // Trazer cliente que sumiu
  AUMENTO_TICKET       // Comprando acima de R$X ganha Y
  GIRO_ESTOQUE         // Queima de acessórios, produtos parados
  SAZONAL              // Produto/serviço de temporada
  LANCAMENTO           // Novo serviço ou produto
  AQUISICAO            // Primeiro banho com desconto, cliente novo
}

enum TipoDesconto {
  PERCENTUAL   // ex: 10% OFF
  FIXO_REAIS   // ex: R$15 OFF
}

// ── Ícone visual no card ──────────────────────────────────────
// Mapeado no frontend para o ícone correto do lucide-react-native
enum TipoCupomIcone {
  DESCONTO      // Tag — desconto genérico
  BANHO_TOSA    // Scissors — serviços de estética
  PRODUTO       // ShoppingBag — produto físico
  VIP           // Award — cupom favorito / cliente especial
  SAZONAL       // Star — campanha sazonal
  SAUDE         // Heart — saúde e medicamentos
  ALIMENTACAO   // UtensilsCrossed — ração e comida
  BRINDE        // Gift — brinde
  COMBO         // Package — combo de serviços
}

// ── Status do resgate ─────────────────────────────────────────
enum StatusResgate {
  ATIVO       // Resgatado, ainda válido
  UTILIZADO   // Apresentado ao atendente
  EXPIRADO    // Passou da dataFim sem uso
}

enum Especie {
  GATO
  CACHORRO
}

enum SexoPet {
  MACHO
  FEMEA
}

enum Sexo {
  MASCULINO
  FEMENINO
  MACHO
  FEMEA
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum Comportamento {
  CALMO
  AGITADO
  SOCIAVEL
  TIMIDO
  AGRESSIVO
  BRINCALHAO
}

enum Convivencia {
  CRIANCAS
  OUTROS_CAES
  GATOS
  ESTRANHOS
  IDOSOS
}

enum TipoSalvo {
  ANALISE
  DICA
}
