// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id              String   @id @default(uuid())
  email           String   @unique
  nome            String
  senha           String
  avatar          String?

  dataNascimento  DateTime?
  sexo            Sexo?

  notificacoesAtivas Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pets            Pet[]
  notificacoes Notificacao[]
  salvos Salvo[]
  aceiteTermos UserAceiteTermos[]
  sosAtendimentos SosAtendimento[]
  petShopsSeguidores  PetShopSeguidor[]
  petShopFavorito     PetShopFavorito?
  cupomResgates       CupomResgate[]

  latitude   Float?
  longitude  Float?
  cidade     String?
  estado     String?
  pais       String?   @default("BR")

  @@map("users")
}


model Notificacao {
  id          String   @id @default(uuid())

  titulo      String
  mensagem    String

  tipo        TipoNotificacao
  pathKey     String?

  lida        Boolean  @default(false)

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  lidaEm      DateTime?

  @@index([userId, lida])
  @@map("notificacoes")
}


model Salvo {
  id          String   @id @default(uuid())

  titulo      String
  descricao   String?

  tipo        TipoSalvo
  referenciaId String
  pathKey     String

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tipo, referenciaId])
  @@map("salvos")
}


model Pet {
  id        String   @id @default(uuid())
  nome      String
  foto      String?
  raca      String?
  
  dataNascimento DateTime?
  idade           Int?
  meses           Int?

  peso     Float?
  especie  Especie
  cor      String?
  sexo     SexoPet
  porte    Porte

  microchip  String?
  castrado   Boolean @default(false)

  veterinarioResponsavel String?

  alergiasRestricoes String[]
  doencasCronicas    String[]

  comportamento Comportamento

  convivencia Convivencia[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
// Relacionamentos para Dicas
  historicosDicas       PetDicaHistorico[] // Oposto de PetDicaHistorico.pet
  respostasDicas        PetDicaResposta[]
  analises AnaliseHistorico[]
  sosAtendimentos SosAtendimento[]
  vacinas Vacina[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pets")
}

model Vacina {
  id           String   @id @default(uuid())
  nome         String
  categoria    String   // "vaccine" ou "dewormer"
  recorrente   Boolean  @default(true)
  
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  doses        DoseVacina[]
  observacoes   String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vacinas")
}

model DoseVacina {
  id           String   @id @default(uuid())
  dataAplicada DateTime
  proximaDose  DateTime?
  tipo         String   // Ex: "Reforço anual", "1ª Dose"
  observacoes   String?   @db.Text
  vacinaId     String
  vacina       Vacina   @relation(fields: [vacinaId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("doses_vacinas")
}


model Dica {
  id          String @id @default(uuid())
  titulo      String
  descricao   String
  icone       String?
  prompt    String?  @db.Text

  createdAt  DateTime @default(now())
historicos  PetDicaHistorico[] // Oposto de PetDicaHistorico.dica
  etapas     DicaEtapa[]
  respostas  PetDicaResposta[]

  @@map("dicas")
}


model DicaEtapa {
  id       String @id @default(uuid())
  titulo   String
  ordem    Int

  dicaId  String
  dica    Dica @relation(fields: [dicaId], references: [id], onDelete: Cascade)

  opcoes  DicaOpcao[]
  respostas PetDicaResposta[]

  @@map("dica_etapas")
}


model DicaOpcao {
  id        String @id @default(uuid())
  texto     String
  valor     String
  ordem     Int

  etapaId  String
  etapa    DicaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  respostas PetDicaResposta[]

  @@map("dica_opcoes")
}


model PetDicaHistorico {
  id          String   @id @default(uuid())
  
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  dicaId      String
  dica        Dica     @relation(fields: [dicaId], references: [id], onDelete: Cascade)

  resultadoIA String?  @db.Text
  concluida   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  respostas   PetDicaResposta[]

  @@map("pet_dica_historicos")
}

// Ajustar o PetDicaResposta para apontar para o Historico em vez de diretamente para o Pet/Dica (opcional, mas recomendado para manter histórico)
model PetDicaResposta {
  id          String   @id @default(uuid())
  
  historicoId String
  historico   PetDicaHistorico @relation(fields: [historicoId], references: [id], onDelete: Cascade)

  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  dicaId      String
  dica        Dica     @relation(fields: [dicaId], references: [id])

  etapaId     String
  etapa       DicaEtapa @relation(fields: [etapaId], references: [id])

  // Alterado para opcional (?) para permitir perguntas de texto puro
  opcaoId     String?
  opcao       DicaOpcao? @relation(fields: [opcaoId], references: [id])

  // CAMPO FALTANTE ADICIONADO ABAIXO:
  valor       String?   @db.Text

  createdAt   DateTime @default(now())

  @@map("pet_dica_respostas")
}


model Analise {
  id          String @id @default(uuid())
  titulo      String
  descricao   String
  icone       String?
  prompt      String?  @db.Text

  createdAt DateTime @default(now())

  etapas     AnaliseEtapa[]

  historicos AnaliseHistorico[]

  @@map("analises")
}


model AnaliseEtapa {
  id       String @id @default(uuid())
  titulo   String
  ordem    Int

  permiteTexto Boolean @default(false)
  permiteFoto  Boolean @default(false)

  analiseId String
  analise   Analise @relation(fields: [analiseId], references: [id], onDelete: Cascade)

  opcoes    AnaliseOpcao[]

  respostas AnaliseResposta[]

  @@map("analise_etapas")
}


model AnaliseOpcao {
  id       String @id @default(uuid())
  texto    String
  valor    String
  ordem    Int

  etapaId String
  etapa   AnaliseEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  respostas AnaliseResposta[]

  @@map("analise_opcoes")
}


model AnaliseHistorico {
  id        String @id @default(uuid())

  petId    String
  pet      Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  analiseId String
  analise   Analise @relation(fields: [analiseId], references: [id])
  resultadoIA String?  @db.Text
  concluida Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respostas AnaliseResposta[]

  @@map("analise_historicos")
}


model AnaliseResposta {
  id String @id @default(uuid())

  historicoId String?
  historico   AnaliseHistorico? @relation(fields: [historicoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   AnaliseEtapa @relation(fields: [etapaId], references: [id])

  opcaoId String?
  opcao   AnaliseOpcao? @relation(fields: [opcaoId], references: [id])

  texto   String?
  fotoUrl String?

  createdAt DateTime @default(now())

  @@unique([historicoId, etapaId])
  @@map("analise_respostas")
}


enum TipoNotificacao {
  DICA
  ANALISE
  LEMBRETE
  SAUDE
  SISTEMA
}


model BannerHome {
  id          String   @id @default(uuid())

  titulo      String?
  descricao   String?

  imagemUrl   String
  pathKey     String?

  ativo       Boolean  @default(true)
  ordem       Int      @default(0)

  dataInicio  DateTime?
  dataFim     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ativo])
  @@map("banners_home")
}

model SosAtendimento {
  id           String   @id @default(uuid())
  mensagemUser String   @db.Text
  respostaIA   String   @db.Text
  
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historico String? @db.Text 

  status    String  @default("ativo") 
  createdAt    DateTime @default(now())

  @@map("sos_atendimentos")
}

model PoliticaPrivacidade {
  id             String   @id @default(uuid())
  versao         String?  @unique // Opcional
  conteudo       String?  @db.Text // Opcional
  publicadoEm    DateTime @default(now())
  
  aceites        UserAceiteTermos[]

  @@map("politicas_privacidade")
}

model TermoUso {
  id             String   @id @default(uuid())
  versao         String?  @unique // Opcional
  conteudo       String?  @db.Text // Opcional
  publicadoEm    DateTime @default(now())

  aceites        UserAceiteTermos[]

  @@map("termos_uso")
}

model UserAceiteTermos {
  id                    String   @id @default(uuid())
  
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  politicaPrivacidadeId String?
  politicaPrivacidade   PoliticaPrivacidade? @relation(fields: [politicaPrivacidadeId], references: [id])

  termoUsoId            String?
  termoUso              TermoUso?            @relation(fields: [termoUsoId], references: [id])

  aceitoEm              DateTime @default(now())
  ip                    String?

  @@map("user_aceite_termos")
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime 
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_codes")
}

// ============================================================
//  BITZY CLUB — Adições ao schema.prisma existente
//  Cole estes models após os models existentes no seu schema.
//  Adicione também os novos enums ao bloco de enums existente.
// ============================================================


// ─────────────────────────────────────────────────────────────
//  PETSHOP PARCEIRO
//  Estabelecimentos cadastrados no Bitzy Club (R$99/mês)
// ─────────────────────────────────────────────────────────────
model PetShop {
  id            String   @id @default(uuid())

  nome          String
  descricao     String?  @db.Text
  logoUrl       String?
  bannerUrl     String?

  // Endereço / localização
  endereco      String
  cidade        String
  estado        String
  pais          String   @default("BR")
  latitude      Float
  longitude     Float

  // Contato
  telefone      String?
  whatsapp      String?
  instagram     String?
  website       String?

  // Plano Bitzy Club
  ativo         Boolean  @default(true)
  planoAtivo    Boolean  @default(false)   // true = pagou R$99/mês
  planoInicioEm DateTime?
  planoFimEm    DateTime?                  // null = recorrente ativo

  // Desconto fixo para quem FAVORITA este pet shop
  // O pet shop escolhe o %, mínimo 5%, padrão 10%
  descontoFavorito Float  @default(10.0)   // ex: 10.0 = 10%

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos
  cupons        Cupom[]
  seguidores    PetShopSeguidor[]
  favoritos     PetShopFavorito[]

  @@index([cidade, estado])
  @@index([latitude, longitude])
  @@index([ativo, planoAtivo])
  @@map("pet_shops")
}


// ─────────────────────────────────────────────────────────────
//  SEGUIDOR DE PET SHOP
//  Usuário "segue" N pet shops para receber promoções
// ─────────────────────────────────────────────────────────────
model PetShopSeguidor {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petShopId  String
  petShop    PetShop  @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, petShopId])   // um usuário segue um pet shop apenas 1 vez
  @@index([userId])
  @@map("pet_shop_seguidores")
}


// ─────────────────────────────────────────────────────────────
//  FAVORITO DE PET SHOP  (limite: 1 por usuário)
//  Quem favorita recebe o descontoFavorito permanente
// ─────────────────────────────────────────────────────────────
model PetShopFavorito {
  id         String   @id @default(uuid())

  userId     String   @unique   // garante 1 favorito por usuário no DB
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petShopId  String
  petShop    PetShop  @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  // Snapshot do desconto no momento que favoritou
  // (mesmo que o pet shop altere o %, o usuário mantém o que foi prometido)
  descontoSnapshot Float

  favoritadoEm DateTime @default(now())

  @@index([petShopId])
  @@map("pet_shop_favoritos")
}


// ─────────────────────────────────────────────────────────────
//  CUPOM
//  Criado pelo pet shop; pode ser fixo, sazonal ou favorito
// ─────────────────────────────────────────────────────────────
model Cupom {
  id            String     @id @default(uuid())

  petShopId     String
  petShop       PetShop    @relation(fields: [petShopId], references: [id], onDelete: Cascade)

  titulo        String                          // ex: "10% em toda loja"
  descricao     String?    @db.Text             // ex: "Válido para produtos de higiene"
  codigoDisplay String?                         // ex: "BITZY10" — mostrado na tela
  iconeTipo     TipoCupomIcone @default(DESCONTO)

  tipo          TipoCupom                       // FIXO | SAZONAL | FAVORITO
  
  // Valor do benefício
  valorDesconto  Float?                         // ex: 10.0 = 10%
  tipoDesconto   TipoDesconto @default(PERCENTUAL) // PERCENTUAL | FIXO_REAIS

  // ── Validade ──────────────────────────────────────────────
  // O pet shop escolhe UMA das três opções ao cadastrar:
  //   ILIMITADO  → dataFim = null, duracaoTipo = ILIMITADO
  //   24_HORAS   → duracaoTipo = HORAS_24, dataFim preenchido automaticamente
  //   1_SEMANA   → duracaoTipo = SEMANA_1, dataFim preenchido automaticamente
  duracaoTipo    DuracaoCupom @default(ILIMITADO)
  dataInicio     DateTime     @default(now())
  dataFim        DateTime?                      // null = sem expiração (ILIMITADO)

  // ── Limites de uso ─────────────────────────────────────────
  limiteUsoTotal    Int?                         // null = sem limite global
  limiteUsoPorUser  Int      @default(1)         // padrão: 1x por usuário

  // ── Métricas ───────────────────────────────────────────────
  totalResgates  Int      @default(0)            // atualizado a cada resgate

  ativo          Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resgates       CupomResgate[]

  @@index([petShopId, ativo])
  @@index([tipo])
  @@index([dataFim])                             // facilita query "expira em breve"
  @@map("cupons")
}


// ─────────────────────────────────────────────────────────────
//  CUPOM RESGATE
//  Registro de cada vez que um usuário resgata/usa um cupom
//  "alienado ao petshop e ao usuário"
// ─────────────────────────────────────────────────────────────
model CupomResgate {
  id         String        @id @default(uuid())

  cupomId    String
  cupom      Cupom         @relation(fields: [cupomId], references: [id], onDelete: Cascade)

  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Status do ciclo de vida do cupom na mão do usuário
  status     StatusResgate @default(ATIVO)

  // Snapshot dos dados no momento do resgate
  // (protege histórico mesmo se o cupom for editado)
  petShopId        String
  petShopNome      String
  cupomTitulo      String
  descontoSnapshot Float?
  dataFimSnapshot  DateTime?          // cópia da dataFim no momento do resgate

  resgatadoEm      DateTime @default(now())
  utilizadoEm      DateTime?          // quando apresentou ao atendente
  expiradoEm       DateTime?          // preenchido por job de expiração

  @@unique([cupomId, userId])         // 1 resgate por cupom por usuário (padrão)
  @@index([userId, status])
  @@index([petShopId])
  @@index([status, dataFimSnapshot])  // job de expiração usa este índice
  @@map("cupom_resgates")
}


enum TipoCupom {
  FIXO       // Disponível sempre enquanto ativo (ex: 10% sempre)
  SAZONAL    // Campanha com data de início e fim (ex: Natal, Black Friday)
  FAVORITO   // Gerado automaticamente ao favoritar; 1 por petshop por usuário
}

enum DuracaoCupom {
  ILIMITADO  // Sem data de expiração
  HORAS_24   // Expira 24h após o resgate
  SEMANA_1   // Expira 7 dias após o resgate
}

enum TipoDesconto {
  PERCENTUAL   // ex: 10% OFF
  FIXO_REAIS   // ex: R$15 OFF
}

enum TipoCupomIcone {
  DESCONTO     // tag de desconto
  BANHO_TOSA   // tesoura/banheira
  PRODUTO      // caixa/produto
  VIP          // estrela
  SAZONAL      // calendário/confete
}

enum StatusResgate {
  ATIVO        // resgatado, ainda válido, não usado
  UTILIZADO    // apresentado ao atendente e marcado como usado
  EXPIRADO     // passou da dataFim sem ser utilizado
}

enum Especie {
  GATO
  CACHORRO
}

enum SexoPet {
  MACHO
  FEMEA
}

enum Sexo {
  MASCULINO
  FEMENINO
  MACHO
  FEMEA
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum Comportamento {
  CALMO
  AGITADO
  SOCIAVEL
  TIMIDO
  AGRESSIVO
  BRINCALHAO
}

enum Convivencia {
  CRIANCAS
  OUTROS_CAES
  GATOS
  ESTRANHOS
  IDOSOS
}

enum TipoSalvo {
  ANALISE
  DICA
}
